{
  "name": "cc-server",
  "version": "1.0.0",
  "description": "Control Plane Server for SuperControlPanel",
  "main": "dist/main.js",
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc --outDir dist --pretty false",
    "start": "npm run build && node dist/main.js",
    "dev": "ts-node src/main.ts",
    "watch": "node --watch --require ts-node/register src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "admin-next:dev": "npm --prefix admin-next run dev",
    "admin-next:test": "npm --prefix admin-next run test",
    "admin-next:test:coverage": "npm --prefix admin-next run test:coverage",
    "admin-next:build": "npm --prefix admin-next run build",
    "test:all": "npm run test && npm run admin-next:test",
    "test:all:coverage": "npm run test:coverage && npm run admin-next:test:coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/platform-ws": "^11.1.19",
    "@nestjs/websockets": "^11.1.19",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "chart.js": "^4.5.1",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.19",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "playwright": "^1.59.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
