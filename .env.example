# ──────────────────────────────────────────────
# cc-server  —  Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# .env is gitignored and will never be committed.
# ──────────────────────────────────────────────

# ── Required ──────────────────────────────────
CC_ADMIN_PASSWORD=change-me-at-least-8-chars
CC_BOOTSTRAP_TOKEN=change-me-at-least-16-characters
CC_CORS_ORIGIN=https://myadmin.example.com

# ── Server ────────────────────────────────────
# PORT=3000
# CC_DB_PATH=./data/cc-server.sqlite

# ── Admin sessions ────────────────────────────
# CC_ADMIN_SESSION_TTL_HOURS=12

# ── Mobile/admin API auth ─────────────────────
# Optional static bootstrap/back-compat bearer token for mobile/admin REST clients.
# The preferred path is to mint revocable DB-backed admin API tokens from /admin.
# CC_ADMIN_API_TOKEN=change-me-at-least-16-characters

# ── Telemetry retention ───────────────────────
# CC_LOG_RETENTION_MAX_EVENTS_PER_DEVICE=5000
# CC_LOG_RETENTION_MAX_AGE_DAYS=30

# ── Rate limiting ─────────────────────────────
# CC_RATE_LIMIT_LOGIN_MAX=10
# CC_RATE_LIMIT_LOGIN_WINDOW_MS=300000
# CC_RATE_LIMIT_ENROLL_MAX=20
# CC_RATE_LIMIT_ENROLL_WINDOW_MS=300000
# CC_RATE_LIMIT_INGEST_MAX=600
# CC_RATE_LIMIT_INGEST_WINDOW_MS=60000
