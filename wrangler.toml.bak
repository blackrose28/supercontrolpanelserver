name = "cc-server-worker"
main = "src/worker/index.ts"
compatibility_date = "2026-04-29"
pages_build_output_dir = "public/admin-next"

# Bindings are introduced incrementally as migration phases land.
# Phase 2 will replace the placeholder database_id with the real D1 id.
[[d1_databases]]
binding = "CC_DB"
database_name = "cc-server"
database_id = "00000000-0000-0000-0000-000000000000"
