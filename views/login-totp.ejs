<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>CC Admin — Verify 2FA</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; margin: 0; background: #f5f5f5; display:flex; min-height:100vh; align-items:center; justify-content:center; }
    .card { width: 360px; background:white; padding:24px; border-radius:12px; box-shadow:0 8px 24px rgba(0,0,0,0.08); }
    h1 { margin-top:0; font-size:22px; }
    input, button { width:100%; box-sizing:border-box; padding:10px 12px; border-radius:8px; font-size:14px; }
    input { border:1px solid #d1d5db; margin-bottom:12px; text-align:center; letter-spacing:4px; font-size:20px; }
    button { border:0; background:#111827; color:white; cursor:pointer; }
  </style>
</head>
<body>
  <form class="card" method="post" action="/admin/login/totp">
    <h1>Two-Factor Authentication</h1>
    <p style="color:#6b7280;margin-top:0;margin-bottom:12px;">Enter the 6-digit code from your authenticator app.</p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="color:#dc2626;margin-bottom:12px;"><%= error %></div>
    <% } %>
    <input name="csrfToken" type="hidden" value="<%= csrfToken %>" />
    <input name="totpCode" type="text" placeholder="000000" maxlength="6" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" />
    <button type="submit">Verify</button>
  </form>
</body>
</html>
